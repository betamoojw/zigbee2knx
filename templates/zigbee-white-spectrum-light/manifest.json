      "1.state",
      "1.brightness",
      "1.brightness_move",
      "1.brightness_move_onoff",
      "1.transition",
      "1.power_on_behavior",
      "1.level_config.current_level_startup",
      "1.identify",
      "1.color_temp",
      "1.color_temp_move",
      "1.color_temp_startup"
    ],
