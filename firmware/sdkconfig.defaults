CONFIG_IDF_TARGET="esp32c6"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
# Zigbee coordinator, native 15.4 radio, native 2.x API (no 1.x compat layer), release libraries
CONFIG_ZB_ENABLED=y
CONFIG_ZB_ZCZR=y
CONFIG_ZB_RADIO_NATIVE=y
# CONFIG_ZB_SDK_1xx is not set
# CONFIG_ZB_DEBUG_MODE is not set
CONFIG_IEEE802154_ENABLED=y
# console on USB-Serial-JTAG only; UART0 stays free, UART1 belongs to the NCN5130
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=6144
CONFIG_FREERTOS_HZ=1000
CONFIG_FREERTOS_USE_TRACE_FACILITY=y
CONFIG_FREERTOS_USE_STATS_FORMATTING_FUNCTIONS=y
# task watchdog: the firmware starts it itself (main.c, wdt_start) for its own tasks, not for the idle task
CONFIG_ESP_TASK_WDT_EN=y
CONFIG_ESP_TASK_WDT_INIT=n
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
